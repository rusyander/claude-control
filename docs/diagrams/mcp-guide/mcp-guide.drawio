        </mxCell>
        <mxCell id="p1:legend:cap4" value="отказ и его причина" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=9;fontColor=#546E7A;verticalAlign=middle;sample=1;" vertex="1" parent="1">
