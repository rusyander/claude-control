          </mxGeometry>
        </mxCell>
        <mxCell id="edge:p1:rank:p1:deny" value="deny" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;fontColor=#37474F;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;jettySize=auto;strokeWidth=2;strokeColor=#1565C0;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1:rank" target="p1:deny">
          <mxGeometry relative="1" x="0" y="-22" as="geometry">
