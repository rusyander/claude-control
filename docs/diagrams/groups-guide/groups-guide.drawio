            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge:p2:automation:p2:cli" value="срабатывает на событии" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;fontColor=#37474F;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;jettySize=auto;strokeWidth=2;strokeColor=#1565C0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.47;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2:automation" target="p2:cli">
