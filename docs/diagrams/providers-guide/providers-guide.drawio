<mxfile host="app.diagrams.net" version="24.7.7">
  <diagram id="p1" name="Что меняет переключение">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1570" pageHeight="960" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p1:title" value="Что меняет один выбор в списке" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;fontColor=#1A237E;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="30" width="1240" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="p1:sub" value="Переключатель переписывает одну строку у панели и перерисовывает её экран. Конфигурации самого CLI он в этот момент не касается." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#546E7A;" vertex="1" parent="1">
          <mxGeometry x="60" y="60" width="1240" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="p:pick" value="&lt;div style=&quot;font-size:10px;font-weight:600;color:#1B5E20;text-align:left&quot;&gt;Кнопка «Выбрать» в списке&lt;/div&gt;&lt;div style=&quot;font-size:9px;text-align:left;margin-top:4px&quot;&gt;Рядом с каждым CLI видно, сколько разделов панели у него готово и нашёлся ли его бинарь в PATH. Обратный переход — тем же кликом.&lt;/div&gt;" style="rounded=1;arcSize=12;fillColor=#E8F5E9;strokeColor=#43A047;strokeWidth=2;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;fontSize=9;fontColor=#37474F;spacingLeft=50;informational=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="150" width="400" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="p:pick:icon" value="вы" style="shape=card;fillColor=#FFFFFF;strokeColor=#43A047;html=1;whiteSpace=wrap;align=center;verticalAlign=bottom;fontSize=7;fontColor=#1B5E20;informational=1;" vertex="1" parent="p:pick">
          <mxGeometry x="10" y="10" width="40" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="p:state" value="&lt;div style=&quot;font-size:10px;font-weight:600;color:#EF6C00;text-align:left&quot;&gt;Одна строка в state.json&lt;/div&gt;&lt;div style=&quot;font-size:9px;text-align:left;margin-top:4px&quot;&gt;agentdeck/state.json → settings.provider. Это всё, что запись переключателя делает на диске.&lt;/div&gt;" style="rounded=1;arcSize=12;fillColor=#FFF3E0;strokeColor=#FB8C00;strokeWidth=2;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;fontSize=9;fontColor=#37474F;spacingLeft=50;informational=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="280" width="400" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="p:state:icon" value="id" style="shape=note;size=14;fillColor=#FFFFFF;strokeColor=#FB8C00;html=1;whiteSpace=wrap;align=center;verticalAlign=bottom;fontSize=7;fontColor=#EF6C00;informational=1;" vertex="1" parent="p:state">
          <mxGeometry x="10" y="10" width="40" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="p:keys" value="&lt;div style=&quot;font-size:10px;font-weight:600;color:#EF6C00;text-align:left&quot;&gt;Ключи — у панели, не у CLI&lt;/div&gt;&lt;div style=&quot;font-size:9px;text-align:left;margin-top:4px&quot;&gt;provider-keys.enc (AES-256-GCM) рядом с ключевым файлом 0600. В конфигурацию чужого CLI ключ не попадает никогда; не задан — берётся из названной переменной окружения.&lt;/div&gt;" style="rounded=1;arcSize=12;fillColor=#FFF3E0;strokeColor=#FB8C00;strokeWidth=2;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;fontSize=9;fontColor=#37474F;spacingLeft=50;informational=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="410" width="400" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="p:keys:icon" value="enc" style="shape=note;size=14;fillColor=#FFFFFF;strokeColor=#FB8C00;html=1;whiteSpace=wrap;align=center;verticalAlign=bottom;fontSize=7;fontColor=#EF6C00;informational=1;" vertex="1" parent="p:keys">
          <mxGeometry x="10" y="10" width="40" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="p:menu" value="&lt;div style=&quot;font-size:10px;font-weight:600;color:#4527A0;text-align:left&quot;&gt;Меню собирается заново&lt;/div&gt;&lt;div style=&quot;font-size:9px;text-align:left;margin-top:4px&quot;&gt;Раздел, которого у этого CLI нет, не показывается серым — его просто нет. Раздел «в разработке» открывается заглушкой и ничего не отправляет.&lt;/div&gt;&lt;div style=&quot;font-size:9px;text-align:left;margin-top:4px&quot;&gt;Имена следуют за CLI: вместо CLAUDE.md в меню встаёт AGENTS.md.&lt;/div&gt;" style="rounded=1;arcSize=12;fillColor=#EDE7F6;strokeColor=#7E57C2;strokeWidth=2;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;fontSize=9;fontColor=#37474F;spacingLeft=50;informational=1;" vertex="1" parent="1">
          <mxGeometry x="540" y="150" width="460" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="p:menu:icon" value="меню" style="shape=hexagon;fillColor=#FFFFFF;strokeColor=#7E57C2;html=1;whiteSpace=wrap;align=center;verticalAlign=bottom;fontSize=7;fontColor=#4527A0;informational=1;" vertex="1" parent="p:menu">
          <mxGeometry x="10" y="10" width="40" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="p:assistant" value="&lt;div style=&quot;font-size:10px;font-weight:600;color:#4527A0;text-align:left&quot;&gt;Помощник ищет своё&lt;/div&gt;&lt;div style=&quot;font-size:9px;text-align:left;margin-top:4px&quot;&gt;Сначала бинарь CLI в PATH, затем ключ в панели, затем переменная окружения. Нет ничего из трёх — помощник скажет, чего не хватает.&lt;/div&gt;" style="rounded=1;arcSize=12;fillColor=#EDE7F6;strokeColor=#7E57C2;strokeWidth=2;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;fontSize=9;fontColor=#37474F;spacingLeft=50;informational=1;" vertex="1" parent="1">
          <mxGeometry x="540" y="290" width="460" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="p:assistant:icon" value="чат" style="shape=process;fillColor=#FFFFFF;strokeColor=#7E57C2;html=1;whiteSpace=wrap;align=center;verticalAlign=bottom;fontSize=7;fontColor=#4527A0;informational=1;" vertex="1" parent="p:assistant">
          <mxGeometry x="10" y="10" width="40" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="p:history" value="&lt;div style=&quot;font-size:10px;font-weight:600;color:#4527A0;text-align:left&quot;&gt;История и поиск идут за провайдером&lt;/div&gt;&lt;div style=&quot;font-size:9px;text-align:left;margin-top:4px&quot;&gt;В ленту и поиск попадают файлы Claude и рабочие разделы активного провайдера. Копии чужих конфигов лежат под своим именем, но восстановления у них нет.&lt;/div&gt;" style="rounded=1;arcSize=12;fillColor=#EDE7F6;strokeColor=#7E57C2;strokeWidth=2;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;fontSize=9;fontColor=#37474F;spacingLeft=50;informational=1;" vertex="1" parent="1">
          <mxGeometry x="540" y="420" width="460" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="p:history:icon" value="лента" style="shape=hexagon;fillColor=#FFFFFF;strokeColor=#7E57C2;html=1;whiteSpace=wrap;align=center;verticalAlign=bottom;fontSize=7;fontColor=#4527A0;informational=1;" vertex="1" parent="p:history">
          <mxGeometry x="10" y="10" width="40" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="p:check" value="&lt;div style=&quot;font-size:10px;font-weight:600;color:#00695C;text-align:left&quot;&gt;Проверка — по временной копии&lt;/div&gt;&lt;div style=&quot;font-size:9px;text-align:left;margin-top:4px&quot;&gt;Круг «прочитали → записали → прочитали» идёт по КОПИИ конфигурации: ваши файлы проверка не меняет. Запуск ассистента — отдельный тумблер, единственный платный шаг.&lt;/div&gt;" style="rounded=1;arcSize=12;fillColor=#E0F2F1;strokeColor=#26A69A;strokeWidth=2;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;fontSize=9;fontColor=#37474F;informational=1;" vertex="1" parent="1">
          <mxGeometry x="1080" y="150" width="430" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="p:files" value="&lt;div style=&quot;font-size:10px;font-weight:600;color:#AD1457;text-align:left&quot;&gt;Файлы CLI ждут первой записи&lt;/div&gt;&lt;div style=&quot;font-size:9px;text-align:left;margin-top:4px&quot;&gt;Переключение не открывает и не правит ни одного чужого файла. Первая запись туда случится, когда вы откроете раздел и нажмёте «Сохранить».&lt;/div&gt;" style="rounded=1;arcSize=12;fillColor=#FCE4EC;strokeColor=#EC407A;strokeWidth=2;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;fontSize=9;fontColor=#37474F;informational=1;" vertex="1" parent="1">
          <mxGeometry x="1080" y="280" width="430" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="p:not" value="&lt;div style=&quot;font-size:10px;font-weight:600;color:#B71C1C;text-align:left&quot;&gt;Чего переключение не делает&lt;/div&gt;&lt;div style=&quot;font-size:9px;text-align:left;margin-top:4px&quot;&gt;Не ставит и не авторизует CLI, не переносит правила и права между ними, не выбирает модель — это соседние разделы.&lt;/div&gt;" style="rounded=1;arcSize=12;fillColor=#FFEBEE;strokeColor=#E53935;strokeWidth=2;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;fontSize=9;fontColor=#37474F;informational=1;" vertex="1" parent="1">
          <mxGeometry x="1080" y="410" width="430" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="edge:p:pick:p:state" value="записывается id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;fontColor=#37474F;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;jettySize=auto;strokeWidth=2;strokeColor=#2E7D32;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p:pick" target="p:state">
          <mxGeometry relative="1" x="0" y="0" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="edge:p:state:p:menu" value="по нему собирается экран" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;fontColor=#37474F;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;jettySize=auto;strokeWidth=2;strokeColor=#1565C0;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="p:state" target="p:menu">
          <mxGeometry relative="1" x="-0.24" y="0" as="geometry">
            <Array as="points">
            <mxPoint x="460" y="198"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge:p:state:p:history" value="и лента, и поиск" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;fontColor=#37474F;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;jettySize=auto;strokeWidth=2;strokeColor=#6D4C41;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p:state" target="p:history">
          <mxGeometry relative="1" x="0.24" y="-44" as="geometry">
            <Array as="points">
            <mxPoint x="460" y="455"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge:p:menu:p:assistant" value="тот же провайдер" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;fontColor=#37474F;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;jettySize=auto;strokeWidth=2;strokeColor=#1565C0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p:menu" target="p:assistant">
          <mxGeometry relative="1" x="0" y="0" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="edge:p:keys:p:assistant" value="ключ или переменная" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;fontColor=#37474F;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;jettySize=auto;strokeWidth=2;strokeColor=#6D4C41;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.9;entryDx=0;entryDy=0;" edge="1" parent="1" source="p:keys" target="p:assistant">
          <mxGeometry relative="1" x="-0.12" y="66" as="geometry">
            <Array as="points">
            <mxPoint x="460" y="353"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge:p:menu:p:check" value="кнопка «Проверить»" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;fontColor=#37474F;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;jettySize=auto;strokeWidth=2;strokeColor=#1565C0;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p:menu" target="p:check">
          <mxGeometry relative="1" x="0" y="44" as="geometry">
