            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge:h:stdin:h:exit" value="ответ скрипта" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;fontColor=#37474F;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;jettySize=auto;strokeWidth=2;strokeColor=#1565C0;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="h:stdin" target="h:exit">
          <mxGeometry relative="1" x="0" y="22" as="geometry">
            <Array as="points">
            <mxPoint x="1080" y="308"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge:h:exit:h:block" value="двойка на двух событиях" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;fontColor=#37474F;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;jettySize=auto;strokeWidth=2;strokeColor=#1565C0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="h:exit" target="h:block">
