            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge:p2:gateway:p2:usage" value="запросы попадают в учёт контура" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;fontColor=#37474F;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;jettySize=auto;strokeWidth=2;strokeColor=#6D4C41;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2:gateway" target="p2:usage">
          <mxGeometry relative="1" x="0" y="0" as="geometry">
            <Array as="points">
