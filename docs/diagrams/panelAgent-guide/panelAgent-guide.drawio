          <mxGeometry x="60" y="820" width="50" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="p1:legend:cap3" value="CLI" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=9;fontColor=#546E7A;verticalAlign=middle;sample=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="820" width="150" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="p1:legend:sw4" value="" style="rounded=1;arcSize=12;fillColor=#E3F2FD;strokeColor=#42A5F5;strokeWidth=2;html=1;sample=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="850" width="50" height="20" as="geometry"/>
