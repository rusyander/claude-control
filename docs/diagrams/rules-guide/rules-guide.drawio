            <mxPoint x="240" y="290"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge:p2:group:p2:on" value="пачкой" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;fontColor=#37474F;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;jettySize=auto;strokeWidth=2;strokeColor=#2E7D32;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2:group" target="p2:on">
          <mxGeometry relative="1" x="0" y="0" as="geometry">
