<mxfile host="app.diagrams.net" version="24.7.7">
  <diagram id="p1" name="1. Где живёт набор">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1120" pageHeight="1490" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p1:title" value="Где живёт набор и кто в него пишет" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;fontColor=#1A237E;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="30" width="1000" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="p1:sub" value="Своей базы у раздела нет: набор — это файлы проекта, а запись прогона собирается из них же." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#546E7A;" vertex="1" parent="1">
          <mxGeometry x="60" y="60" width="1000" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="p1:human" value="&lt;div style=&quot;font-size:10px;font-weight:600;color:#1B5E20;text-align:left&quot;&gt;Человек&lt;/div&gt;&lt;div style=&quot;font-size:9px;text-align:left;margin-top:4px&quot;&gt;Ведёт кейсы руками и проходит их шаг за шагом — в панели или с телефона.&lt;/div&gt;" style="rounded=1;arcSize=12;fillColor=#E8F5E9;strokeColor=#43A047;strokeWidth=2;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;fontSize=9;fontColor=#37474F;spacingLeft=50;informational=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="130" width="300" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="p1:human:icon" value="QA" style="shape=actor;fillColor=#FFFFFF;strokeColor=#43A047;html=1;whiteSpace=wrap;align=center;verticalAlign=bottom;fontSize=7;fontColor=#1B5E20;informational=1;" vertex="1" parent="p1:human">
          <mxGeometry x="10" y="10" width="40" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="p1:agent" value="&lt;div style=&quot;font-size:10px;font-weight:600;color:#4527A0;text-align:left&quot;&gt;Агент CLI&lt;/div&gt;&lt;div style=&quot;font-size:9px;text-align:left;margin-top:4px&quot;&gt;Генерация, прогон, исследование, автоматизация. На время прогона ему разрешены только файлы тестов.&lt;/div&gt;" style="rounded=1;arcSize=12;fillColor=#EDE7F6;strokeColor=#7E57C2;strokeWidth=2;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;fontSize=9;fontColor=#37474F;spacingLeft=50;informational=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="130" width="300" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="p1:agent:icon" value="CLI" style="shape=process;fillColor=#FFFFFF;strokeColor=#7E57C2;html=1;whiteSpace=wrap;align=center;verticalAlign=bottom;fontSize=7;fontColor=#4527A0;informational=1;" vertex="1" parent="p1:agent">
          <mxGeometry x="10" y="10" width="40" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="p1:ci" value="&lt;div style=&quot;font-size:10px;font-weight:600;color:#37474F;text-align:left&quot;&gt;Чужой прогон: CI&lt;/div&gt;&lt;div style=&quot;font-size:9px;text-align:left;margin-top:4px&quot;&gt;Отчёт JUnit, Playwright или Allure приходит импортом — панель его не запускала.&lt;/div&gt;" style="rounded=1;arcSize=12;fillColor=#ECEFF1;strokeColor=#78909C;strokeWidth=2;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;fontSize=9;fontColor=#37474F;spacingLeft=50;informational=1;" vertex="1" parent="1">
          <mxGeometry x="740" y="130" width="300" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="p1:ci:icon" value="CI" style="shape=cloud;fillColor=#FFFFFF;strokeColor=#78909C;html=1;whiteSpace=wrap;align=center;verticalAlign=bottom;fontSize=7;fontColor=#37474F;informational=1;" vertex="1" parent="p1:ci">
          <mxGeometry x="10" y="10" width="40" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="p1:panel" value="&lt;div style=&quot;font-size:10px;font-weight:600;color:#AD1457;text-align:left&quot;&gt;Панель&lt;/div&gt;&lt;div style=&quot;font-size:9px;text-align:left;margin-top:4px&quot;&gt;Читает и пишет файлы проекта. Ничего своего не хранит и ничего не сливает в базу.&lt;/div&gt;" style="rounded=1;arcSize=12;fillColor=#FCE4EC;strokeColor=#EC407A;strokeWidth=2;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;fontSize=9;fontColor=#37474F;spacingLeft=50;informational=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="330" width="300" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="p1:panel:icon" value="API" style="shape=hexagon;fillColor=#FFFFFF;strokeColor=#EC407A;html=1;whiteSpace=wrap;align=center;verticalAlign=bottom;fontSize=7;fontColor=#AD1457;informational=1;" vertex="1" parent="p1:panel">
          <mxGeometry x="10" y="10" width="40" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="p1:filesTitle" value="Файлы проекта: .agent/tests/" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#EF6C00;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="520" width="500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="p1:cases" value="&lt;div style=&quot;font-size:10px;font-weight:600;color:#EF6C00;text-align:left&quot;&gt;группа.tests.json&lt;/div&gt;&lt;div style=&quot;font-size:9px;text-align:left;margin-top:4px&quot;&gt;Кейсы группы и последний статус каждого: пройден, провален, карантин с причиной.&lt;/div&gt;" style="rounded=1;arcSize=12;fillColor=#FFF3E0;strokeColor=#FB8C00;strokeWidth=2;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;fontSize=9;fontColor=#37474F;spacingLeft=50;informational=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="560" width="300" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="p1:cases:icon" value="json" style="shape=cylinder3;backgroundOutline=1;size=7;fillColor=#FFFFFF;strokeColor=#FB8C00;html=1;whiteSpace=wrap;align=center;verticalAlign=bottom;fontSize=7;fontColor=#EF6C00;informational=1;" vertex="1" parent="p1:cases">
          <mxGeometry x="10" y="10" width="40" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="p1:runs" value="&lt;div style=&quot;font-size:10px;font-weight:600;color:#EF6C00;text-align:left&quot;&gt;runs/идентификатор.run.json&lt;/div&gt;&lt;div style=&quot;font-size:9px;text-align:left;margin-top:4px&quot;&gt;Запись прогона: кто гонял, по какой ветке и вехе, что вышло по каждому кейсу.&lt;/div&gt;" style="rounded=1;arcSize=12;fillColor=#FFF3E0;strokeColor=#FB8C00;strokeWidth=2;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;fontSize=9;fontColor=#37474F;spacingLeft=50;informational=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="560" width="300" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="p1:runs:icon" value="run" style="shape=cylinder3;backgroundOutline=1;size=7;fillColor=#FFFFFF;strokeColor=#FB8C00;html=1;whiteSpace=wrap;align=center;verticalAlign=bottom;fontSize=7;fontColor=#EF6C00;informational=1;" vertex="1" parent="p1:runs">
          <mxGeometry x="10" y="10" width="40" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="p1:files" value="&lt;div style=&quot;font-size:10px;font-weight:600;color:#EF6C00;text-align:left&quot;&gt;attachments, plans, views, environments&lt;/div&gt;&lt;div style=&quot;font-size:9px;text-align:left;margin-top:4px&quot;&gt;Доказательства провалов, планы, сохранённые отборы и окружения стенда.&lt;/div&gt;" style="rounded=1;arcSize=12;fillColor=#FFF3E0;strokeColor=#FB8C00;strokeWidth=2;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;fontSize=9;fontColor=#37474F;spacingLeft=50;informational=1;" vertex="1" parent="1">
          <mxGeometry x="740" y="560" width="300" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="p1:files:icon" value="файлы" style="shape=cylinder3;backgroundOutline=1;size=7;fillColor=#FFFFFF;strokeColor=#FB8C00;html=1;whiteSpace=wrap;align=center;verticalAlign=bottom;fontSize=7;fontColor=#EF6C00;informational=1;" vertex="1" parent="p1:files">
          <mxGeometry x="10" y="10" width="40" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="p1:git" value="&lt;div style=&quot;font-size:10px;font-weight:600;color:#37474F;text-align:left&quot;&gt;git проекта&lt;/div&gt;&lt;div style=&quot;font-size:9px;text-align:left;margin-top:4px&quot;&gt;Кейсы и прогоны едут в коммит вместе с кодом: ветка с правкой несёт и правку кейсов, а слияние сводит их обычным способом.&lt;/div&gt;" style="rounded=1;arcSize=12;fillColor=#ECEFF1;strokeColor=#78909C;strokeWidth=2;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;fontSize=9;fontColor=#37474F;informational=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="760" width="980" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="p1:assembled" value="&lt;div style=&quot;font-size:10px;font-weight:600;color:#EF6C00;text-align:left&quot;&gt;Запись прогона считается по кейсам, а не по счётчику&lt;/div&gt;&lt;div style=&quot;font-size:9px;text-align:left;margin-top:4px&quot;&gt;В начале прогона панель запоминает отпечаток выбранных кейсов и в конце штампует те, что изменились.&lt;/div&gt;&lt;div style=&quot;font-size:9px;text-align:left;margin-top:4px&quot;&gt;Кейса, которого исполнитель не тронул, в записи не будет: пустая запись — это «агент ничего не отметил», а не «панель потеряла».&lt;/div&gt;" style="rounded=1;arcSize=12;fillColor=#FFFDE7;strokeColor=#F9A825;strokeWidth=2;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;fontSize=9;fontColor=#37474F;informational=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="920" width="640" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="p1:secrets" value="&lt;div style=&quot;font-size:10px;font-weight:600;color:#B71C1C;text-align:left&quot;&gt;Пароли стенда — не в проекте&lt;/div&gt;&lt;div style=&quot;font-size:9px;text-align:left;margin-top:4px&quot;&gt;Окружение в файле, доступы к нему — в панели, зашифрованными. В кейс, промпт и отчёт они не попадают.&lt;/div&gt;" style="rounded=1;arcSize=12;fillColor=#FFEBEE;strokeColor=#E53935;strokeWidth=2;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;fontSize=9;fontColor=#37474F;informational=1;" vertex="1" parent="1">
          <mxGeometry x="740" y="920" width="300" height="70" as="geometry"/>
        </mxCell>
