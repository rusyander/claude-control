        </mxCell>
        <mxCell id="edge:p1:cli:p1:feed" value="ответ кадрами, пока идёт прогон" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;fontColor=#37474F;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;jettySize=auto;strokeWidth=2;strokeColor=#78909C;dashed=1;dashPattern=6 4;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1:cli" target="p1:feed">
          <mxGeometry relative="1" x="0" y="0" as="geometry">
