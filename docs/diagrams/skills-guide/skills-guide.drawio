            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge:d:rename:d:state" value="переносит отметки" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;fontColor=#37474F;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;jettySize=auto;strokeWidth=2;strokeColor=#2E7D32;exitX=0.9;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="d:rename" target="d:state">
          <mxGeometry relative="1" x="0" y="0" as="geometry">
            <Array as="points">
            <mxPoint x="420" y="270"/>
            <mxPoint x="1290" y="270"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge:d:delete:d:backup" value="сначала копия" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;fontColor=#37474F;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;jettySize=auto;strokeWidth=2;strokeColor=#2E7D32;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d:delete" target="d:backup">
          <mxGeometry relative="1" x="0" y="0" as="geometry">
