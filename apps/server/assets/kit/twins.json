  "kitOnly": {
    "hooks-lib:items.mjs": "Kit plumbing: the manifest that lets the panel switch each guard off; the personal layer wires dispatchers in settings.json.",
    "hooks-lib:kit-paths.mjs": "Kit plumbing: paths of a kit copied per run into the panel data dir, and which CLI is calling.",
    "hooks-lib:local-discipline.mjs": "Local-model runs only (AGENTDECK_KIT_VARIANT=local), which the panel launches.",
    "hooks-lib:run.mjs": "Kit plumbing: the one dispatcher per event; the personal layer has its own *-dispatch.mjs scripts."
  },
  "globalOnly": {
    "hooks-lib:autonomous-pick.mjs": "Owner's personal AskUserQuestion auto-pick; inert since the panel retired chat autonomy (02.11.2026) and strips AGENTDECK_AUTONOMOUS from every run: not shipped.",
    "hooks-lib:hooks-audit.mjs": "Audits the personal settings.json hook wiring; the kit is composed by the panel and checked by its tests.",
    "hooks-lib:jira-readback.mjs": "Owner's company tracker (Jira wiki markup read-back): not shipped.",
    "hooks-lib:listing-churn-guard.mjs": "Guards edits of the owner's own skills/agents listing in ~/.claude; panel runs edit skills through the panel API.",
    "hooks-lib:mr-probe.mjs": "Probe for undraft-guard against the owner's company GitLab: not shipped.",
    "hooks-lib:prompt-input.mjs": "Reader for the personal standalone UserPromptSubmit hooks; the kit parses input in lib/run.mjs.",
    "hooks-lib:ready-for-test-gate.mjs": "Owner's company ticket workflow (Ready for test): not shipped.",
    "hooks-lib:ready-for-test-probe.mjs": "Probe for ready-for-test-gate (company Jira/GitLab): not shipped.",
    "hooks-lib:skill-usage.mjs": "Personal skill-usage ledger; the panel reads skill use from transcripts.",
    "hooks-lib:tracker-id-guard.mjs": "Owner's company tracker labels: not shipped.",
    "hooks-lib:undraft-guard.mjs": "Owner's company MR ledger and draft workflow: not shipped."
  },
  "wiring": [
    {
      "module": "forge-merge-guard",
      "tools": [
        "Bash",
        "PowerShell",
        "mcp__gitlab__merge_merge_request"
      ],
      "apply": "add the forge MCP tools (mcp__.*(gitlab|github).*) to the settings.json PreToolUse matcher of pre-tool-dispatch.mjs"
    },
    {
      "module": "mcp-shape-guard",
      "tools": [
        "mcp__gitlab__mr_discussions"
      ],
      "apply": "add the forge MCP tools (mcp__.*(gitlab|github).*) to the settings.json PreToolUse matcher of pre-tool-dispatch.mjs"
    },
    {
      "module": "nvm-use-guard",
      "tools": [
        "Bash",
        "PowerShell"
      ],
      "apply": "add Bash|PowerShell to the settings.json PreToolUse matcher of pre-tool-dispatch.mjs"
    }
  ]
