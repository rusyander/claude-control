            <mxPoint x="460" y="267"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge:o:own:o:feed" value="копии" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;fontColor=#37474F;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;jettySize=auto;strokeWidth=2;strokeColor=#6D4C41;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="o:own" target="o:feed">
          <mxGeometry relative="1" x="0" y="-22" as="geometry">
            <Array as="points">
            <mxPoint x="460" y="412"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge:o:files:o:watch" value="файл изменился" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;fontColor=#37474F;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;jettySize=auto;strokeWidth=2;strokeColor=#1565C0;dashed=1;dashPattern=6 4;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.2;entryDx=0;entryDy=0;" edge="1" parent="1" source="o:files" target="o:watch">
          <mxGeometry relative="1" x="0" y="44" as="geometry">
