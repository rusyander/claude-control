        <mxCell id="p1:legend:cap2" value="ядро" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=9;fontColor=#546E7A;verticalAlign=middle;sample=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="540" width="150" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="p1:legend:sw3" value="" style="rounded=1;arcSize=12;fillColor=#FFF3E0;strokeColor=#FB8C00;strokeWidth=2;html=1;sample=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="570" width="50" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="p1:legend:cap3" value="что ядро помнит" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=9;fontColor=#546E7A;verticalAlign=middle;sample=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="570" width="150" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="p1:legend:sw4" value="" style="rounded=1;arcSize=12;fillColor=#FFEBEE;strokeColor=#E53935;strokeWidth=2;html=1;sample=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="600" width="50" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="p1:legend:cap4" value="границы" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=9;fontColor=#546E7A;verticalAlign=middle;sample=1;" vertex="1" parent="1">
