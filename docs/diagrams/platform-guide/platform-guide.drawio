            <mxPoint x="590" y="515"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p2:legend:title" value="Обозначения" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#37474F;fontStyle=1;" vertex="1" parent="1">
