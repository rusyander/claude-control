            <mxPoint x="1000" y="199"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge:h:feed:h:list" value="записи" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;fontColor=#37474F;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;jettySize=auto;strokeWidth=2;strokeColor=#1565C0;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="h:feed" target="h:list">
