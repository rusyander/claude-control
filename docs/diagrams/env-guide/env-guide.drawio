            <mxPoint x="1060" y="304"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge:e:secrets:e:subst" value="только сюда" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;fontColor=#37474F;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;jettySize=auto;strokeWidth=2;strokeColor=#6D4C41;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="e:secrets" target="e:subst">
