        <mxCell id="p1:legend:cap6" value="значок формы: карточка, сервер, процесс, файл" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=9;fontColor=#546E7A;verticalAlign=middle;sample=1;" vertex="1" parent="1">
