          </mxGeometry>
        </mxCell>
        <mxCell id="p1:legend:cap6" value="дальше по пути" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=9;fontColor=#546E7A;verticalAlign=middle;sample=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="850" width="150" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="p1:legend:sw7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;fontColor=#37474F;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;jettySize=auto;strokeWidth=2;strokeColor=#6D4C41;sample=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="60" y="890" as="sourcePoint"/>
            <mxPoint x="110" y="890" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="p1:legend:cap7" value="чтение и запись" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=9;fontColor=#546E7A;verticalAlign=middle;sample=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="880" width="150" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="p1:legend:sw8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;fontColor=#37474F;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;jettySize=auto;strokeWidth=2;strokeColor=#78909C;dashed=1;dashPattern=6 4;sample=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="60" y="920" as="sourcePoint"/>
            <mxPoint x="110" y="920" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="p1:legend:cap8" value="проверка оборвалась" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=9;fontColor=#546E7A;verticalAlign=middle;sample=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="910" width="150" height="20" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p2" name="2. Кто держит сервер">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="1020" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p2:title" value="Кто на самом деле запускает сервер" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;fontColor=#1A237E;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="30" width="1100" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="p2:sub" value="Панель правит файл и умеет позвонить. Держит серверы Claude Code — и берёт их состав один раз, при старте сессии." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#546E7A;" vertex="1" parent="1">
          <mxGeometry x="60" y="60" width="1100" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="p2:panel" value="&lt;div style=&quot;font-size:10px;font-weight:600;color:#4527A0;text-align:left&quot;&gt;Панель&lt;/div&gt;&lt;div style=&quot;font-size:9px;text-align:left;margin-top:4px&quot;&gt;Пишет ~/.claude.json, проверяет связь, спрашивает список инструментов.&lt;/div&gt;&lt;div style=&quot;font-size:9px;text-align:left;margin-top:4px&quot;&gt;Ни один сервер не остаётся работать после проверки: сессия закрывается сразу, процесс гасится.&lt;/div&gt;" style="rounded=1;arcSize=12;fillColor=#EDE7F6;strokeColor=#7E57C2;strokeWidth=2;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;fontSize=9;fontColor=#37474F;spacingLeft=50;informational=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="150" width="400" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="p2:panel:icon" value="панель" style="shape=hexagon;fillColor=#FFFFFF;strokeColor=#7E57C2;html=1;whiteSpace=wrap;align=center;verticalAlign=bottom;fontSize=7;fontColor=#4527A0;informational=1;" vertex="1" parent="p2:panel">
          <mxGeometry x="10" y="10" width="40" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="p2:file" value="&lt;div style=&quot;font-size:10px;font-weight:600;color:#EF6C00;text-align:left&quot;&gt;~/.claude.json&lt;/div&gt;&lt;div style=&quot;font-size:9px;text-align:left;margin-top:4px&quot;&gt;Единственное, что связывает панель и агента. Своей базы серверов у панели нет.&lt;/div&gt;&lt;div style=&quot;font-size:9px;text-align:left;margin-top:4px&quot;&gt;Тот же файл правят руками и командой claude mcp — панель показывает результат одинаково.&lt;/div&gt;" style="rounded=1;arcSize=12;fillColor=#FFF3E0;strokeColor=#FB8C00;strokeWidth=2;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;fontSize=9;fontColor=#37474F;spacingLeft=50;informational=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="150" width="400" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="p2:file:icon" value="json" style="shape=note;size=14;fillColor=#FFFFFF;strokeColor=#FB8C00;html=1;whiteSpace=wrap;align=center;verticalAlign=bottom;fontSize=7;fontColor=#EF6C00;informational=1;" vertex="1" parent="p2:file">
          <mxGeometry x="10" y="10" width="40" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="p2:cli" value="&lt;div style=&quot;font-size:10px;font-weight:600;color:#AD1457;text-align:left&quot;&gt;Claude Code&lt;/div&gt;&lt;div style=&quot;font-size:9px;text-align:left;margin-top:4px&quot;&gt;При старте поднимает каждый ВКЛЮЧЁННЫЙ сервер как свой подпроцесс и держит его всю сессию.&lt;/div&gt;&lt;div style=&quot;font-size:9px;text-align:left;margin-top:4px&quot;&gt;Сервер, добавленный только что, появится у агента после перезапуска — это и значит надпись «Изменения применятся после перезапуска».&lt;/div&gt;" style="rounded=1;arcSize=12;fillColor=#FCE4EC;strokeColor=#EC407A;strokeWidth=2;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;fontSize=9;fontColor=#37474F;spacingLeft=50;informational=1;" vertex="1" parent="1">
          <mxGeometry x="1060" y="150" width="400" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="p2:cli:icon" value="CLI" style="shape=process;fillColor=#FFFFFF;strokeColor=#EC407A;html=1;whiteSpace=wrap;align=center;verticalAlign=bottom;fontSize=7;fontColor=#AD1457;informational=1;" vertex="1" parent="p2:cli">
          <mxGeometry x="10" y="10" width="40" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="p2:server" value="&lt;div style=&quot;font-size:10px;font-weight:600;color:#00695C;text-align:left&quot;&gt;Сам MCP-сервер&lt;/div&gt;&lt;div style=&quot;font-size:9px;text-align:left;margin-top:4px&quot;&gt;Чужой процесс или чужой адрес: панель в нём ничего не настраивает и ничего о нём не знает, кроме того, что он сам расскажет.&lt;/div&gt;&lt;div style=&quot;font-size:9px;text-align:left;margin-top:4px&quot;&gt;Его инструменты приходят агенту под именами mcp__&lt;сервер&gt;__&lt;инструмент&gt; — отсюда и вид правил доступа.&lt;/div&gt;" style="rounded=1;arcSize=12;fillColor=#E0F2F1;strokeColor=#26A69A;strokeWidth=2;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;fontSize=9;fontColor=#37474F;spacingLeft=50;informational=1;" vertex="1" parent="1">
          <mxGeometry x="1060" y="320" width="400" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="p2:server:icon" value="MCP" style="shape=process;fillColor=#FFFFFF;strokeColor=#26A69A;html=1;whiteSpace=wrap;align=center;verticalAlign=bottom;fontSize=7;fontColor=#00695C;informational=1;" vertex="1" parent="p2:server">
          <mxGeometry x="10" y="10" width="40" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="p2:perms" value="&lt;div style=&quot;font-size:10px;font-weight:600;color:#1565C0;text-align:left&quot;&gt;Права — отдельный слой&lt;/div&gt;&lt;div style=&quot;font-size:9px;text-align:left;margin-top:4px&quot;&gt;«Сервер отвечает» не значит «им можно пользоваться»: вызов каждого инструмента проходит через права доступа.&lt;/div&gt;&lt;div style=&quot;font-size:9px;text-align:left;margin-top:4px&quot;&gt;mcp__orders разрешает сервер целиком, mcp__orders__refund_order — один инструмент. Запрет на инструмент сильнее разрешения на сервер.&lt;/div&gt;" style="rounded=1;arcSize=12;fillColor=#E3F2FD;strokeColor=#42A5F5;strokeWidth=2;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;fontSize=9;fontColor=#37474F;informational=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="320" width="400" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="p2:off" value="&lt;div style=&quot;font-size:10px;font-weight:600;color:#B71C1C;text-align:left&quot;&gt;Выключенный сервер&lt;/div&gt;&lt;div style=&quot;font-size:9px;text-align:left;margin-top:4px&quot;&gt;Запись переезжает в mcpServersDisabled того же файла: Claude Code её не видит.&lt;/div&gt;&lt;div style=&quot;font-size:9px;text-align:left;margin-top:4px&quot;&gt;Настройки сохраняются целиком — тумблер возвращает сервер ровно таким, каким он был.&lt;/div&gt;" style="rounded=1;arcSize=12;fillColor=#FFEBEE;strokeColor=#E53935;strokeWidth=2;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;fontSize=9;fontColor=#37474F;informational=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="310" width="400" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="p2:secrets" value="&lt;div style=&quot;font-size:10px;font-weight:600;color:#EF6C00;text-align:left&quot;&gt;Токен живёт не здесь&lt;/div&gt;&lt;div style=&quot;font-size:9px;text-align:left;margin-top:4px&quot;&gt;~/.claude.json — не место для секрета: файл читают и панель, и агент, и соседние инструменты.&lt;/div&gt;&lt;div style=&quot;font-size:9px;text-align:left;margin-top:4px&quot;&gt;В поля пишут ссылку ${VAR}, а значение заводят в разделе «Переменные» — в .mcp-secrets.env.&lt;/div&gt;" style="rounded=1;arcSize=12;fillColor=#FFFDE7;strokeColor=#F9A825;strokeWidth=2;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;fontSize=9;fontColor=#37474F;informational=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="460" width="400" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="edge:p2:panel:p2:file" value="запись и проверка" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;fontColor=#37474F;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;jettySize=auto;strokeWidth=2;strokeColor=#6D4C41;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2:panel" target="p2:file">
          <mxGeometry relative="1" x="0" y="0" as="geometry">
            <Array as="points">
            <mxPoint x="560" y="190"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge:p2:file:p2:cli" value="читается при старте сессии" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;fontColor=#37474F;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;jettySize=auto;strokeWidth=2;strokeColor=#1565C0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2:file" target="p2:cli">
          <mxGeometry relative="1" x="0" y="-66" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="edge:p2:cli:p2:server" value="запускает и держит" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;fontColor=#37474F;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;jettySize=auto;strokeWidth=2;strokeColor=#1565C0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2:cli" target="p2:server">
          <mxGeometry relative="1" x="0" y="0" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="edge:p2:server:p2:perms" value="вызов инструмента" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;fontColor=#37474F;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;jettySize=auto;strokeWidth=2;strokeColor=#1565C0;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2:server" target="p2:perms">
          <mxGeometry relative="1" x="0" y="0" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="edge:p2:off:p2:file" value="тумблер переносит запись" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;fontColor=#37474F;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;jettySize=auto;strokeWidth=2;strokeColor=#2E7D32;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.85;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2:off" target="p2:file">
          <mxGeometry relative="1" x="-0.12" y="0" as="geometry">
            <Array as="points">
            <mxPoint x="460" y="227"/>
            </Array>
          </mxGeometry>
        </mxCell>
