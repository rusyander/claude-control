        <mxCell id="p3:legend:cap0" value="человек и то, что он видит" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=9;fontColor=#546E7A;verticalAlign=middle;sample=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="1290" width="270" height="20" as="geometry"/>
