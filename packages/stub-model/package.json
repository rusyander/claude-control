{
  "name": "@agentdeck/stub-model",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Заглушка модели по сценарию: четыре протокола провода (Anthropic messages, OpenAI chat и responses, Google generateContent), поток SSE, след запросов — одна на тесты ядра и проверки tools/qa",
  "exports": {
    ".": {
      "types": "./src/index.d.mts",
      "default": "./src/index.mjs"
    },
    "./scenarios/contour": {
      "types": "./src/scenarios/contour.d.mts",
      "default": "./src/scenarios/contour.mjs"
    },
    "./scenarios/panel-agent": {
      "types": "./src/scenarios/panel-agent.d.mts",
      "default": "./src/scenarios/panel-agent.mjs"
    }
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
