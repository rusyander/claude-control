          <mxGeometry x="60" y="630" width="50" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="p1:legend:cap5" value="значок — чья это коробка" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=9;fontColor=#546E7A;verticalAlign=middle;sample=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="630" width="150" height="20" as="geometry"/>
