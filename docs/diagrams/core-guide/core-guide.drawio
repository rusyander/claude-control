        <mxCell id="p1:legend:cap0" value="человек и его экран" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=9;fontColor=#546E7A;verticalAlign=middle;sample=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="480" width="150" height="20" as="geometry"/>
