        </mxCell>
        <mxCell id="p2:legend:cap6" value="спрашивает панель" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=9;fontColor=#546E7A;verticalAlign=middle;sample=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="940" width="220" height="20" as="geometry"/>
