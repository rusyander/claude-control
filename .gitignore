node_modules/
dist/
*.local
.DS_Store

# Сборка Storybook — артефакт, пересобирается командой storybook build
storybook-static/

# Скриншоты и артефакты проверок — рабочий мусор, в репозитории не нужны
.qa-screenshots/
.agent

# Отчёт о покрытии — генерируется `vitest run --coverage`, в историю не нужен
coverage/
# Отчёт JUnit прогона через блок тестов (`tools/qa/junit-run.mjs`) — пересоздаётся каждым прогоном
test-results/

# Релизный APK телефонного приложения — пересобирается `pnpm mobile:apk`
/*.apk

# Отчёт фонового наблюдателя — локальный, пересылается руками
/WATCH-REPORT.md
# Личные черновики в корне (`.vsc-tmp.mjs` и т. п.) — не код проекта
/.*-tmp.mjs
