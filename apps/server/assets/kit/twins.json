{
  "$comment": "Ledger of tools/kit-twins.mjs: kit copies vs their originals in the owner's ~/.claude. Edit one side of a pair -> port it to the other -> node tools/kit-twins.mjs --accept <key>. Never accept without porting.",
  "roots": [
    {
      "id": "hooks-lib",
      "kit": "agentdeck-kit/hooks/lib",
      "global": "hooks/lib",
      "pattern": "^(?!(?:context-budget|doc-hygiene-autoclean|postcompact-clear-advisor|precompact-checkpoint|project-onboard-check).mjs$).+.mjs$",
      "strict": true,
      "portWhy": "De-branded port: the kit copy drops the owner's company, tracker and forge names and personal paths, resolves its paths from the kit root (kit-paths.mjs) and reads every calling CLI's input shape (normalize); the guarded behaviour is the same.",
      "kitOnlyWhy": "Kit plumbing or a behaviour the personal layer gets from settings.json or CLAUDE.md instead of a module.",
      "globalOnlyWhy": "Owner-specific (the company tracker/forge, personal audits of ~/.claude): not shipped to other machines."
    },
    {
      "id": "hooks-top",
      "kit": "agentdeck-kit/hooks/lib",
      "global": "hooks",
      "pattern": "^(?:context-budget|doc-hygiene-autoclean|postcompact-clear-advisor|precompact-checkpoint|project-onboard-check).mjs$",
      "strict": true,
      "portWhy": "The personal layer runs these as standalone hook scripts (hooks/<name>.mjs, one settings.json entry each); the kit runs the same behaviour as a module of its event dispatcher (lib/run.mjs). Ported, not copied: kit paths, every CLI's input shape.",
      "kitOnlyWhy": "",
      "globalOnlyWhy": ""
    },
    {
      "id": "rules",
      "kit": "agentdeck-kit/skills/situational-rules/references",
      "global": "hooks/rules",
      "pattern": "^[^/]+\\.md$",
      "strict": true,
      "portWhy": "De-branded port of the situational rule card: company names, personal paths and the owner's dated decisions removed; the rule itself is the same.",
      "kitOnlyWhy": "A rule card only the kit delivers (the personal layer states it in CLAUDE.md).",
      "globalOnlyWhy": "A rule card about the owner's own projects or setup: not shipped.",
      "rename": {
        "forge-protocol.md": "mcp-protocol.md"
      },
      "globalPrivate": {
        "pattern": "^[^/]+-(frontend|backend).md$",
        "why": "Rule cards of the owner's own company projects (<project>-frontend.md / -backend.md): never shipped, never named here."
      }
    },
    {
      "id": "tools",
      "kit": "agentdeck-kit/tools",
      "global": "tools",
      "pattern": "^[^/]+\\.mjs$",
      "strict": false,
      "portWhy": "De-branded port of the helper the kit's skills and hooks call; same behaviour, kit paths.",
      "kitOnlyWhy": "",
      "globalOnlyWhy": ""
    },
    {
      "id": "skills",
      "kit": "agentdeck-kit/skills",
      "global": "skills",
      "pattern": "^[^/]+/SKILL\\.md$",
      "strict": false,
      "portWhy": "De-branded port of the skill (kit namespace agentdeck-kit:, kit tool paths, no company specifics).",
      "kitOnlyWhy": "",
      "globalOnlyWhy": ""
    },
    {
      "id": "watch-skills",
      "kit": "agentdeck-kit/skills",
      "global": "skills",
      "pattern": "^(?:watchdog|agentdeck-watchdog)/(?:scripts|references)/.+$",
      "strict": true,
      "portWhy": "The group-watch skills ship with the kit: scripts byte-equal to the personal copy (each resolves its layer at run time — where.mjs, panel.mjs), references ported to kit paths and neutral wording.",
      "kitOnlyWhy": "",
      "globalOnlyWhy": ""
    }
  ],
