{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    // Относительный импорт ЗНАЧЕНИЯ внутри пакета обязан нести расширение `.ts`:
    // сервер грузит эти файлы как есть (`node --experimental-strip-types`), и без
    // расширения он не находит модуль и падает на старте — вся панель, а не одна
    // ручка. Тип-импорты стираются и этой беды не знают, но правило одно для всех:
    // ошибиться тут стоит холодного старта.
    "allowImportingTsExtensions": true
  },
  "include": ["src"]
}
