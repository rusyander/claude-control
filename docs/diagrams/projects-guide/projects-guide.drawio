  <diagram id="p2" name="2. Тот же проект у другого CLI">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1460" pageHeight="1340" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p2:title" value="Один реестр — разные файлы" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;fontColor=#1A237E;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="30" width="1340" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="p2:sub" value="Запись о проекте общая для всех CLI. Вкладки его карточки называются файлами активного: у каждого CLI свой файл инструкций и свой формат конфига." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#546E7A;" vertex="1" parent="1">
          <mxGeometry x="60" y="60" width="1340" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="p2:registry" value="&lt;div style=&quot;font-size:10px;font-weight:600;color:#4527A0;text-align:left&quot;&gt;Реестр панели: путь и имя&lt;/div&gt;&lt;div style=&quot;font-size:9px;text-align:left;margin-top:4px&quot;&gt;Одна запись на проект. Смена активного CLI её не трогает — список проектов остаётся тем же.&lt;/div&gt;&lt;div style=&quot;font-size:9px;text-align:left;margin-top:4px&quot;&gt;Активный CLI выбирается в «Настройки → Провайдеры», и карточка проекта перерисовывается под него.&lt;/div&gt;" style="rounded=1;arcSize=12;fillColor=#EDE7F6;strokeColor=#7E57C2;strokeWidth=2;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;fontSize=9;fontColor=#37474F;spacingLeft=50;informational=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="130" width="440" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="p2:registry:icon" value="state" style="shape=cylinder3;backgroundOutline=1;size=7;fillColor=#FFFFFF;strokeColor=#7E57C2;html=1;whiteSpace=wrap;align=center;verticalAlign=bottom;fontSize=7;fontColor=#4527A0;informational=1;" vertex="1" parent="p2:registry">
          <mxGeometry x="10" y="10" width="40" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="p2:claude" value="" style="rounded=1;arcSize=2;fillColor=#FCE4EC;strokeColor=#EC407A;strokeWidth=3;html=1;verticalAlign=top;align=left;container=1;collapsible=0;informational=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="420" width="440" height="400" as="geometry"/>
        </mxCell>
        <mxCell id="p2:claude:tab" value="Claude Code&lt;div style=&quot;font-size:9px&quot;&gt;вкладки: Правила · MCP-серверы · Права · Из проекта&lt;/div&gt;" style="rounded=0;fillColor=#EC407A;strokeColor=none;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;fontStyle=1;fontColor=#FFFFFF;informational=1;" vertex="1" parent="p2:claude">
          <mxGeometry x="10" y="10" width="420" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="p2:claude:md" value="&lt;div style=&quot;font-size:10px;font-weight:600;color:#AD1457;text-align:left&quot;&gt;CLAUDE.md&lt;/div&gt;&lt;div style=&quot;font-size:9px;text-align:left;margin-top:4px&quot;&gt;Инструкции проекта. Правятся текстом целиком, с резервной копией перед записью.&lt;/div&gt;" style="rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#EC407A;strokeWidth=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;fontSize=9;fontColor=#37474F;informational=1;" vertex="1" parent="p2:claude">
          <mxGeometry x="20" y="70" width="400" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="p2:claude:mcp" value="&lt;div style=&quot;font-size:10px;font-weight:600;color:#AD1457;text-align:left&quot;&gt;.mcp.json — формат JSON&lt;/div&gt;&lt;div style=&quot;font-size:9px;text-align:left;margin-top:4px&quot;&gt;Серверы проекта в корне репозитория.&lt;/div&gt;" style="rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#EC407A;strokeWidth=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;fontSize=9;fontColor=#37474F;informational=1;" vertex="1" parent="p2:claude">
          <mxGeometry x="20" y="150" width="400" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="p2:claude:perm" value="&lt;div style=&quot;font-size:10px;font-weight:600;color:#AD1457;text-align:left&quot;&gt;.claude/settings.json&lt;/div&gt;&lt;div style=&quot;font-size:9px;text-align:left;margin-top:4px&quot;&gt;Права проекта; записи с пометкой «личное» — в .claude/settings.local.json.&lt;/div&gt;" style="rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#EC407A;strokeWidth=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;fontSize=9;fontColor=#37474F;informational=1;" vertex="1" parent="p2:claude">
          <mxGeometry x="20" y="230" width="400" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="p2:claude:local" value="&lt;div style=&quot;font-size:10px;font-weight:600;color:#AD1457;text-align:left&quot;&gt;Вкладка «Из проекта» — только у Claude&lt;/div&gt;&lt;div style=&quot;font-size:9px;text-align:left;margin-top:4px&quot;&gt;Собственный .claude репозитория: скиллы, хуки, файлы правил. У остальных CLI такой вкладки нет вовсе.&lt;/div&gt;" style="rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#EC407A;strokeWidth=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;fontSize=9;fontColor=#37474F;informational=1;" vertex="1" parent="p2:claude">
          <mxGeometry x="20" y="310" width="400" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="p2:codex" value="" style="rounded=1;arcSize=2;fillColor=#E3F2FD;strokeColor=#42A5F5;strokeWidth=3;html=1;verticalAlign=top;align=left;container=1;collapsible=0;informational=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="420" width="440" height="340" as="geometry"/>
        </mxCell>
        <mxCell id="p2:codex:tab" value="Codex CLI (пример чужого)&lt;div style=&quot;font-size:9px&quot;&gt;вкладки: AGENTS.md · MCP-серверы&lt;/div&gt;" style="rounded=0;fillColor=#42A5F5;strokeColor=none;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;fontStyle=1;fontColor=#FFFFFF;informational=1;" vertex="1" parent="p2:codex">
          <mxGeometry x="10" y="10" width="420" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="p2:codex:md" value="&lt;div style=&quot;font-size:10px;font-weight:600;color:#1565C0;text-align:left&quot;&gt;AGENTS.md&lt;/div&gt;&lt;div style=&quot;font-size:9px;text-align:left;margin-top:4px&quot;&gt;Тот же проект, другой файл инструкций. Панель прямо называет его в шапке вкладки и в подсказке о перезапуске.&lt;/div&gt;" style="rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#42A5F5;strokeWidth=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;fontSize=9;fontColor=#37474F;informational=1;" vertex="1" parent="p2:codex">
          <mxGeometry x="20" y="70" width="400" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="p2:codex:mcp" value="&lt;div style=&quot;font-size:10px;font-weight:600;color:#1565C0;text-align:left&quot;&gt;.codex/config.toml — формат TOML&lt;/div&gt;&lt;div style=&quot;font-size:9px;text-align:left;margin-top:4px&quot;&gt;Серверы того же проекта, но другой файл и другой синтаксис: панель пишет в его формате, а не в JSON.&lt;/div&gt;" style="rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#42A5F5;strokeWidth=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;fontSize=9;fontColor=#37474F;informational=1;" vertex="1" parent="p2:codex">
          <mxGeometry x="20" y="160" width="400" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="p2:codex:sections" value="&lt;div style=&quot;font-size:10px;font-weight:600;color:#1565C0;text-align:left&quot;&gt;Список вкладок решает сервер&lt;/div&gt;&lt;div style=&quot;font-size:9px;text-align:left;margin-top:4px&quot;&gt;Разделы приходят от панели по возможностям провайдера, а не подбираются в браузере: чего у CLI нет, того и не покажут.&lt;/div&gt;" style="rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#42A5F5;strokeWidth=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;fontSize=9;fontColor=#37474F;informational=1;" vertex="1" parent="p2:codex">
          <mxGeometry x="20" y="250" width="400" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="p2:apart" value="&lt;div style=&quot;font-size:10px;font-weight:600;color:#B71C1C;text-align:left&quot;&gt;Файлы не связаны между собой&lt;/div&gt;&lt;div style=&quot;font-size:9px;text-align:left;margin-top:4px&quot;&gt;Правка CLAUDE.md не попадает в AGENTS.md и наоборот: это два разных файла одного репозитория.&lt;/div&gt;&lt;div style=&quot;font-size:9px;text-align:left;margin-top:4px&quot;&gt;Проект, с которым работают двумя CLI, инструкции держит в двух местах — и расходятся они молча.&lt;/div&gt;" style="rounded=1;arcSize=12;fillColor=#FFEBEE;strokeColor=#E53935;strokeWidth=2;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;fontSize=9;fontColor=#37474F;informational=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="900" width="440" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="p2:restart" value="&lt;div style=&quot;font-size:10px;font-weight:600;color:#EF6C00;text-align:left&quot;&gt;Перезапуск называется по имени CLI&lt;/div&gt;&lt;div style=&quot;font-size:9px;text-align:left;margin-top:4px&quot;&gt;Строка под редактором говорит «изменения применятся после перезапуска Codex CLI» — именно того CLI, чей файл вы только что сохранили.&lt;/div&gt;" style="rounded=1;arcSize=12;fillColor=#FFFDE7;strokeColor=#F9A825;strokeWidth=2;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;fontSize=9;fontColor=#37474F;informational=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="900" width="440" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="p2:experimental" value="&lt;div style=&quot;font-size:10px;font-weight:600;color:#EF6C00;text-align:left&quot;&gt;Полоса «экспериментально»&lt;/div&gt;&lt;div style=&quot;font-size:9px;text-align:left;margin-top:4px&quot;&gt;Проверен и поддержан полностью только Claude Code. У остальных CLI панель честно предупреждает об этом сверху страницы.&lt;/div&gt;" style="rounded=1;arcSize=12;fillColor=#FFFDE7;strokeColor=#F9A825;strokeWidth=2;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;fontSize=9;fontColor=#37474F;informational=1;" vertex="1" parent="1">
          <mxGeometry x="1060" y="130" width="340" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="edge:p2:registry:p2:claude" value="активный CLI — Claude Code" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;fontColor=#37474F;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;jettySize=auto;strokeWidth=2;strokeColor=#1565C0;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2:registry" target="p2:claude">
