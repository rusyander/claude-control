            <mxPoint x="1020" y="327"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge:w:local:w:cli" value="при старте сессии" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;fontColor=#37474F;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;jettySize=auto;strokeWidth=2;strokeColor=#6D4C41;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="w:local" target="w:cli">
          <mxGeometry relative="1" x="0" y="44" as="geometry">
