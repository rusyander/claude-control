        <mxCell id="edge:p2:muted:p2:verdictGreen" value="в вердикт не идёт" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;fontColor=#37474F;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;jettySize=auto;strokeWidth=2;strokeColor=#EF6C00;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2:muted" target="p2:verdictGreen">
          <mxGeometry relative="1" x="0" y="0" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="edge:p2:verdictRed:p2:gateRed" value="и в гейт" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;fontColor=#37474F;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;jettySize=auto;strokeWidth=2;strokeColor=#1565C0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2:verdictRed" target="p2:gateRed">
          <mxGeometry relative="1" x="0" y="0" as="geometry">
          </mxGeometry>
