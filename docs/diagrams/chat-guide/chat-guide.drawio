          </mxGeometry>
        </mxCell>
        <mxCell id="p1:legend:cap9" value="чтение и запись файлов" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=9;fontColor=#546E7A;verticalAlign=middle;sample=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="1370" width="270" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="p1:legend:sw10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;fontColor=#37474F;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;jettySize=auto;strokeWidth=2;strokeColor=#2E7D32;sample=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="60" y="1410" as="sourcePoint"/>
            <mxPoint x="110" y="1410" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="p1:legend:cap10" value="решение человека" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=9;fontColor=#546E7A;verticalAlign=middle;sample=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="1400" width="270" height="20" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p2" name="2. Конвейер разделения">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1160" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p2:title" value="Что происходит после «Разделить»" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;fontColor=#1A237E;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="30" width="1560" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="p2:sub" value="Слева направо — четыре стадии. Ни одна из них не сливает ветки: это остаётся человеку, и панель об этом говорит прямо." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#546E7A;" vertex="1" parent="1">
          <mxGeometry x="60" y="60" width="1560" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="p2:parent" value="" style="rounded=1;arcSize=2;fillColor=#E8F5E9;strokeColor=#43A047;strokeWidth=3;html=1;verticalAlign=top;align=left;container=1;collapsible=0;informational=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="150" width="380" height="440" as="geometry"/>
        </mxCell>
        <mxCell id="p2:parent:tab" value="Родитель&lt;div style=&quot;font-size:9px&quot;&gt;разговор, в котором всё началось&lt;/div&gt;" style="rounded=0;fillColor=#43A047;strokeColor=none;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;fontStyle=1;fontColor=#FFFFFF;informational=1;" vertex="1" parent="p2:parent">
          <mxGeometry x="10" y="10" width="360" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="p2:proposal" value="&lt;div style=&quot;font-size:10px;font-weight:600;color:#1B5E20;text-align:left&quot;&gt;Предложение агента&lt;/div&gt;&lt;div style=&quot;font-size:9px;text-align:left;margin-top:4px&quot;&gt;Блок разделения в ответе панель рисует карточкой: группа, ветка, список задач, род работы и подобранная модель.&lt;/div&gt;" style="rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#43A047;strokeWidth=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;fontSize=9;fontColor=#37474F;informational=1;" vertex="1" parent="p2:parent">
          <mxGeometry x="20" y="70" width="340" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="p2:decision" value="&lt;div style=&quot;font-size:10px;font-weight:600;color:#1B5E20;text-align:left&quot;&gt;Решение человека&lt;/div&gt;&lt;div style=&quot;font-size:9px;text-align:left;margin-top:4px&quot;&gt;Разделить или делать здесь по очереди — два равных ответа. Тумблер «только завести чаты» заводит группы, не запуская агентов.&lt;/div&gt;" style="rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#43A047;strokeWidth=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;fontSize=9;fontColor=#37474F;informational=1;" vertex="1" parent="p2:parent">
          <mxGeometry x="20" y="160" width="340" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="p2:hub" value="&lt;div style=&quot;font-size:10px;font-weight:600;color:#1B5E20;text-align:left&quot;&gt;Сводка групп&lt;/div&gt;&lt;div style=&quot;font-size:9px;text-align:left;margin-top:4px&quot;&gt;Карточка в ленте родителя: стадии цепочки, модель, время работы, задержка первой правки. Вопросы и запросы прав детей приходят сюда же.&lt;/div&gt;" style="rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#43A047;strokeWidth=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;fontSize=9;fontColor=#37474F;informational=1;" vertex="1" parent="p2:parent">
          <mxGeometry x="20" y="250" width="340" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="p2:pause" value="&lt;div style=&quot;font-size:10px;font-weight:600;color:#1B5E20;text-align:left&quot;&gt;Пауза всего дерева&lt;/div&gt;&lt;div style=&quot;font-size:9px;text-align:left;margin-top:4px&quot;&gt;«Остановить всё» гасит разговор вместе с потомками, «Продолжить всё» возвращает их. Считается это от корня дерева, в какой бы его ветке ни нажали.&lt;/div&gt;" style="rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#43A047;strokeWidth=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;fontSize=9;fontColor=#37474F;informational=1;" vertex="1" parent="p2:parent">
          <mxGeometry x="20" y="340" width="340" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="p2:triage" value="" style="rounded=1;arcSize=2;fillColor=#EDE7F6;strokeColor=#7E57C2;strokeWidth=3;html=1;verticalAlign=top;align=left;container=1;collapsible=0;informational=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="150" width="380" height="450" as="geometry"/>
        </mxCell>
        <mxCell id="p2:triage:tab" value="Разбор&lt;div style=&quot;font-size:9px&quot;&gt;один прогон в корне репозитория&lt;/div&gt;" style="rounded=0;fillColor=#7E57C2;strokeColor=none;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;fontStyle=1;fontColor=#FFFFFF;informational=1;" vertex="1" parent="p2:triage">
          <mxGeometry x="10" y="10" width="360" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="p2:readonly" value="&lt;div style=&quot;font-size:10px;font-weight:600;color:#4527A0;text-align:left&quot;&gt;Только чтение&lt;/div&gt;&lt;div style=&quot;font-size:9px;text-align:left;margin-top:4px&quot;&gt;Разбор идёт на потолке разговора и не правит ничего, что бы ни говорил тумблер правок: он раскладывает задачи и называет, какие файлы чьи.&lt;/div&gt;" style="rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#7E57C2;strokeWidth=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;fontSize=9;fontColor=#37474F;informational=1;" vertex="1" parent="p2:triage">
          <mxGeometry x="20" y="70" width="340" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="p2:verdict" value="&lt;div style=&quot;font-size:10px;font-weight:600;color:#4527A0;text-align:left&quot;&gt;Ответ блоком&lt;/div&gt;&lt;div style=&quot;font-size:9px;text-align:left;margin-top:4px&quot;&gt;Порядок групп, зависимости «после», владение файлами. Панель ответу не доверяет: потерянная задача возвращается домой, дубль остаётся в первой группе, цикл теряет связь.&lt;/div&gt;" style="rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#7E57C2;strokeWidth=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;fontSize=9;fontColor=#37474F;informational=1;" vertex="1" parent="p2:triage">
          <mxGeometry x="20" y="170" width="340" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="p2:repairs" value="&lt;div style=&quot;font-size:10px;font-weight:600;color:#4527A0;text-align:left&quot;&gt;Починки названы&lt;/div&gt;&lt;div style=&quot;font-size:9px;text-align:left;margin-top:4px&quot;&gt;Каждая правка разбора видна в сводке отдельной пометкой — не «применено», а что именно было поправлено.&lt;/div&gt;" style="rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#7E57C2;strokeWidth=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;fontSize=9;fontColor=#37474F;informational=1;" vertex="1" parent="p2:triage">
          <mxGeometry x="20" y="270" width="340" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="p2:missing" value="&lt;div style=&quot;font-size:10px;font-weight:600;color:#4527A0;text-align:left&quot;&gt;Сбой не блокирует&lt;/div&gt;&lt;div style=&quot;font-size:9px;text-align:left;margin-top:4px&quot;&gt;Разбор упал, остановлен или пришёл без блока — группы стартуют ровно так, как предложил агент, и в ленте об этом сказано.&lt;/div&gt;" style="rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#7E57C2;strokeWidth=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;fontSize=9;fontColor=#37474F;informational=1;" vertex="1" parent="p2:triage">
          <mxGeometry x="20" y="360" width="340" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="p2:group" value="" style="rounded=1;arcSize=2;fillColor=#E3F2FD;strokeColor=#42A5F5;strokeWidth=3;html=1;verticalAlign=top;align=left;container=1;collapsible=0;informational=1;" vertex="1" parent="1">
          <mxGeometry x="1060" y="150" width="380" height="450" as="geometry"/>
        </mxCell>
        <mxCell id="p2:group:tab" value="Группа&lt;div style=&quot;font-size:9px&quot;&gt;свой чат, своя копия, своя ветка&lt;/div&gt;" style="rounded=0;fillColor=#42A5F5;strokeColor=none;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;fontStyle=1;fontColor=#FFFFFF;informational=1;" vertex="1" parent="p2:group">
          <mxGeometry x="10" y="10" width="360" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="p2:worktree" value="&lt;div style=&quot;font-size:10px;font-weight:600;color:#1565C0;text-align:left&quot;&gt;Копия репозитория&lt;/div&gt;&lt;div style=&quot;font-size:9px;text-align:left;margin-top:4px&quot;&gt;Отдельный каталог РЯДОМ с проектом: &lt;репозиторий&gt;-worktrees/&lt;ветка&gt;. Общая история, своя ветка, свой локальный слой и своя установка зависимостей.&lt;/div&gt;" style="rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#42A5F5;strokeWidth=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;fontSize=9;fontColor=#37474F;informational=1;" vertex="1" parent="p2:group">
          <mxGeometry x="20" y="70" width="340" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="p2:plan" value="&lt;div style=&quot;font-size:10px;font-weight:600;color:#1565C0;text-align:left&quot;&gt;План&lt;/div&gt;&lt;div style=&quot;font-size:9px;text-align:left;margin-top:4px&quot;&gt;Первый прогон группы: на потолке и без правок. Из плана собирается задание работе, и оно уходит в него дословно.&lt;/div&gt;" style="rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#42A5F5;strokeWidth=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;fontSize=9;fontColor=#37474F;informational=1;" vertex="1" parent="p2:group">
          <mxGeometry x="20" y="170" width="340" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="p2:work" value="&lt;div style=&quot;font-size:10px;font-weight:600;color:#1565C0;text-align:left&quot;&gt;Работа&lt;/div&gt;&lt;div style=&quot;font-size:9px;text-align:left;margin-top:4px&quot;&gt;Модель подбирается под род задачи и никогда не выше потолка. Правки идут только в копии этой группы.&lt;/div&gt;" style="rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#42A5F5;strokeWidth=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;fontSize=9;fontColor=#37474F;informational=1;" vertex="1" parent="p2:group">
          <mxGeometry x="20" y="260" width="340" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="p2:queue" value="&lt;div style=&quot;font-size:10px;font-weight:600;color:#1565C0;text-align:left&quot;&gt;Очередь и ожидание&lt;/div&gt;&lt;div style=&quot;font-size:9px;text-align:left;margin-top:4px&quot;&gt;Группа с «после» ждёт конца всей цепочки предшественника и ветвится от его ветки. Группа с «hold» не получает чата, пока человек не ответит в родителе.&lt;/div&gt;" style="rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#42A5F5;strokeWidth=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;fontSize=9;fontColor=#37474F;informational=1;" vertex="1" parent="p2:group">
          <mxGeometry x="20" y="350" width="340" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="p2:check" value="" style="rounded=1;arcSize=2;fillColor=#E0F2F1;strokeColor=#26A69A;strokeWidth=3;html=1;verticalAlign=top;align=left;container=1;collapsible=0;informational=1;" vertex="1" parent="1">
          <mxGeometry x="1560" y="150" width="380" height="460" as="geometry"/>
        </mxCell>
        <mxCell id="p2:check:tab" value="Проверка&lt;div style=&quot;font-size:9px&quot;&gt;цена работы ниже потолка&lt;/div&gt;" style="rounded=0;fillColor=#26A69A;strokeColor=none;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;fontStyle=1;fontColor=#FFFFFF;informational=1;" vertex="1" parent="p2:check">
          <mxGeometry x="10" y="10" width="360" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="p2:review" value="&lt;div style=&quot;font-size:10px;font-weight:600;color:#00695C;text-align:left&quot;&gt;Ревью&lt;/div&gt;&lt;div style=&quot;font-size:9px;text-align:left;margin-top:4px&quot;&gt;Работа шла ниже потолка — панель поднимает разговор на потолок и просит проверку. Замечания приходят списком; пустой список закрывает цепочку спокойно.&lt;/div&gt;" style="rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#26A69A;strokeWidth=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;fontSize=9;fontColor=#37474F;informational=1;" vertex="1" parent="p2:check">
          <mxGeometry x="20" y="70" width="340" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="p2:fix" value="&lt;div style=&quot;font-size:10px;font-weight:600;color:#00695C;text-align:left&quot;&gt;Исправления&lt;/div&gt;&lt;div style=&quot;font-size:9px;text-align:left;margin-top:4px&quot;&gt;Возвращаются на ту же модель, которой делалась работа. Стадия исправлений последняя: ещё одного круга не будет.&lt;/div&gt;" style="rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#26A69A;strokeWidth=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;fontSize=9;fontColor=#37474F;informational=1;" vertex="1" parent="p2:check">
          <mxGeometry x="20" y="170" width="340" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="p2:overlap" value="&lt;div style=&quot;font-size:10px;font-weight:600;color:#00695C;text-align:left&quot;&gt;Пересечения веток&lt;/div&gt;&lt;div style=&quot;font-size:9px;text-align:left;margin-top:4px&quot;&gt;Считаются на конце цепочки и по кнопке «Сверить ветки»: изменённые файлы каждой ветки плюс несохранённое в копии. Красным — файл вне владения группы.&lt;/div&gt;" style="rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#26A69A;strokeWidth=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;fontSize=9;fontColor=#37474F;informational=1;" vertex="1" parent="p2:check">
          <mxGeometry x="20" y="260" width="340" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="p2:merge" value="&lt;div style=&quot;font-size:10px;font-weight:600;color:#00695C;text-align:left&quot;&gt;Слияние — за человеком&lt;/div&gt;&lt;div style=&quot;font-size:9px;text-align:left;margin-top:4px&quot;&gt;Панель не сливает, не перебазирует и не переключает ветки. Порядок слияния она показывает подсказкой рядом со списком — и на этом останавливается.&lt;/div&gt;" style="rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#26A69A;strokeWidth=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;fontSize=9;fontColor=#37474F;informational=1;" vertex="1" parent="p2:check">
          <mxGeometry x="20" y="360" width="340" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="p2:note" value="&lt;div style=&quot;font-size:10px;font-weight:600;color:#EF6C00;text-align:left&quot;&gt;Субагентов здесь нет ни одного&lt;/div&gt;&lt;div style=&quot;font-size:9px;text-align:left;margin-top:4px&quot;&gt;Каждая группа — обычный разговор, в который человек может войти и написать сам. Уровни разбора и плана добавляют прогонов, но не создают ни одной сущности, которой нельзя было бы задать вопрос.&lt;/div&gt;" style="rounded=1;arcSize=12;fillColor=#FFFDE7;strokeColor=#F9A825;strokeWidth=2;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=6;fontSize=9;fontColor=#37474F;informational=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="690" width="1880" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="edge:p2:decision:p2:readonly" value="разделить" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;fontColor=#37474F;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;jettySize=auto;strokeWidth=2;strokeColor=#2E7D32;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2:decision" target="p2:readonly">
          <mxGeometry relative="1" x="0" y="0" as="geometry">
            <Array as="points">
            <mxPoint x="580" y="345"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge:p2:verdict:p2:plan" value="разбор применён" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;fontColor=#37474F;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;jettySize=auto;strokeWidth=2;strokeColor=#1565C0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2:verdict" target="p2:plan">
          <mxGeometry relative="1" x="0" y="0" as="geometry">
            <Array as="points">
            <mxPoint x="1080" y="360"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge:p2:work:p2:review" value="работа закончилась" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;fontColor=#37474F;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;jettySize=auto;strokeWidth=2;strokeColor=#1565C0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2:work" target="p2:review">
          <mxGeometry relative="1" x="0" y="-66" as="geometry">
            <Array as="points">
            <mxPoint x="1420" y="260"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge:p2:overlap:p2:hub" value="новый факт — в сводку родителя" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;fontColor=#37474F;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;jettySize=auto;strokeWidth=2;strokeColor=#78909C;dashed=1;dashPattern=6 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2:overlap" target="p2:hub">
          <mxGeometry relative="1" x="0" y="0" as="geometry">
            <Array as="points">
            <mxPoint x="1970" y="450"/>
            <mxPoint x="1970" y="640"/>
            <mxPoint x="30" y="640"/>
            <mxPoint x="30" y="435"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p2:legend:title" value="Обозначения" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#37474F;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="810" width="310" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="p2:legend:sw0" value="" style="rounded=1;arcSize=12;fillColor=#E8F5E9;strokeColor=#43A047;strokeWidth=2;html=1;sample=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="840" width="30" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="p2:legend:sw0b" value="" style="rounded=0;fillColor=#43A047;strokeColor=none;html=1;sample=1;" vertex="1" parent="1">
