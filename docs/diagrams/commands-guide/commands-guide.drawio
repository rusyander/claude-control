        </mxCell>
        <mxCell id="p1:legend:cap2" value="что видно на экране" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=9;fontColor=#546E7A;verticalAlign=middle;sample=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="710" width="180" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="p1:legend:sw3" value="" style="rounded=1;arcSize=12;fillColor=#E3F2FD;strokeColor=#42A5F5;strokeWidth=2;html=1;sample=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="740" width="50" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="p1:legend:cap3" value="собранный список" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=9;fontColor=#546E7A;verticalAlign=middle;sample=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="740" width="180" height="20" as="geometry"/>
