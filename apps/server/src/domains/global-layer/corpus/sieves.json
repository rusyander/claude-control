{
  "base": {
    "package.json": "{\n  \"name\": \"demo\",\n  \"scripts\": { \"test\": \"vitest\" },\n  \"dependencies\": {\n    \"left-pad\": \"^1.3.0\"\n  }\n}\n",
    "pnpm-lock.yaml": "lockfileVersion: '9.0'\n",
    "README.md": "# demo\n",
    "src/app.ts": "export function main(): number {\n  return 1;\n}\n"
  },
  "cases": [
    {
      "id": "secret-vendor-key",
      "title": {
        "ru": "Ключ вендора в коде",
        "en": "Vendor-shaped API key in code"
      },
      "branch": {
        "src/config.ts": "export const KEY = '{{secret:sk}}';\n"
      },
      "expect": {
        "secrets": ["src/config.ts"]
      }
    },
    {
      "id": "secret-placeholder",
      "title": {
        "ru": "Ключ-заглушка в README — не секрет",
        "en": "Placeholder key in README is not a secret"
      },
      "branch": {
        "README.md": "# demo\n\nSet OPENAI_API_KEY={{secret:sk-placeholder}}\n"
      },
      "expect": {
        "secrets": []
      }
    },
    {
      "id": "secret-local-db-url",
      "title": {
        "ru": "Адрес локальной базы в compose — не секрет",
        "en": "Local dev database URL in compose is not a secret"
      },
      "branch": {
        "docker-compose.yml": "services:\n  app:\n    environment:\n      DATABASE_URL: {{secret:url-local}}\n"
      },
      "expect": {
        "secrets": []
      }
    },
    {
      "id": "secret-remote-db-url",
      "title": {
        "ru": "Пароль в адресе удалённой базы",
        "en": "Password in a remote database URL"
      },
      "branch": {
        "src/db.ts": "export const url = '{{secret:url-remote}}';\n"
      },
      "expect": {
        "secrets": ["src/db.ts"]
      }
    },
    {
      "id": "secret-private-key",
      "title": {
        "ru": "Добавлен приватный ключ",
        "en": "Private key block added"
      },
      "branch": {
        "deploy/id.txt": "{{secret:pem}}\nAAAA\n"
      },
      "expect": {
        "secrets": ["deploy/id.txt"]
      }
    },
    {
      "id": "debug-focused-test",
      "title": {
        "ru": "Сфокусированный тест (.only) в тестах",
        "en": "Focused test (.only) left in a test file"
      },
      "branch": {
        "src/app.test.ts": "import { it } from 'vitest';\nit.only('main', () => {});\n"
      },
      "expect": {
        "debug-leftovers": ["src/app.test.ts"]
      }
    },
    {
      "id": "debug-debugger",
      "title": {
        "ru": "debugger в коде продукта",
        "en": "debugger statement in product code"
      },
      "branch": {
        "src/app.ts": "export function main(): number {\n  debugger;\n  return 1;\n}\n"
      },
      "expect": {
        "debug-leftovers": ["src/app.ts"]
      }
    },
    {
      "id": "debug-markdown-heading",
      "title": {
        "ru": "Подчёркивание заголовка в Markdown — не маркер конфликта",
        "en": "Setext heading underline in Markdown is not a conflict marker"
      },
      "branch": {
        "docs/guide.md": "Guide\n=======\n\nText.\n"
      },
      "expect": {
        "debug-leftovers": []
      }
    },
    {
      "id": "debug-conflict-marker",
      "title": {
        "ru": "Маркер конфликта слияния в коде",
        "en": "Merge conflict marker left in code"
      },
      "branch": {
        "src/app.ts": "export function main(): number {\n<<<<<<< HEAD\n  return 1;\n=======\n  return 2;\n>>>>>>> feature\n}\n"
      },
      "expect": {
        "debug-leftovers": ["src/app.ts"]
      }
    },
    {
      "id": "lockfile-gap",
      "title": {
        "ru": "Зависимость добавлена без лок-файла",
        "en": "Dependency added without the lockfile"
      },
      "branch": {
        "package.json": "{\n  \"name\": \"demo\",\n  \"scripts\": { \"test\": \"vitest\" },\n  \"dependencies\": {\n    \"left-pad\": \"^1.3.0\",\n    \"zod\": \"^3.23.0\"\n  }\n}\n"
      },
      "expect": {
        "lockfile-sync": ["package.json"]
      }
    },
    {
      "id": "lockfile-script-only",
      "title": {
        "ru": "Правка скрипта в package.json лок-файла не требует",
        "en": "Script change in package.json needs no lockfile"
      },
      "branch": {
        "package.json": "{\n  \"name\": \"demo\",\n  \"scripts\": { \"test\": \"vitest run\" },\n  \"dependencies\": {\n    \"left-pad\": \"^1.3.0\"\n  }\n}\n"
      },
      "expect": {
        "lockfile-sync": []
      }
    },
    {
      "id": "env-undeclared",
      "title": {
        "ru": "Новая переменная окружения без значения и без объявления",
        "en": "New env var read with no default and no declaration"
      },
      "branch": {
        "src/pay.ts": "export const url = process.env.PAYMENTS_URL;\n"
      },
      "expect": {
        "env-config": ["PAYMENTS_URL"]
      }
    },
    {
      "id": "env-declared",
      "title": {
        "ru": "Новая переменная объявлена в .env.example",
        "en": "New env var declared in .env.example"
      },
      "branch": {
        "src/pay.ts": "export const url = process.env.PAYMENTS_URL;\n",
        ".env.example": "PAYMENTS_URL=\n"
      },
      "expect": {
        "env-config": []
      }
    },
    {
      "id": "env-default",
      "title": {
        "ru": "Новая переменная со значением по умолчанию в той же строке",
        "en": "New env var read with a default on the same line"
      },
      "branch": {
        "src/pay.ts": "export const url = process.env.PAYMENTS_URL ?? 'http://127.0.0.1:9000';\n"
      },
      "expect": {
        "env-config": []
      }
    },
    {
      "id": "artifact-env-file",
      "title": {
        "ru": "Закоммичен локальный .env",
        "en": "Local .env file committed"
      },
      "branch": {
        ".env": "TOKEN=abc\n"
      },
      "expect": {
        "committed-artifacts": [".env"]
      }
    },
    {
      "id": "consumers-removed-export",
      "title": {
        "ru": "Удалённый экспорт ещё используется",
        "en": "Removed export still used elsewhere"
      },
      "base": {
        "src/money.ts": "export function formatPrice(value: number): string {\n  return value.toFixed(2);\n}\n",
        "src/page.ts": "import { formatPrice } from './money';\nexport const label = formatPrice(1);\n"
      },
      "branch": {
        "src/money.ts": "export const CURRENCY = 'EUR';\n"
      },
      "expect": {
        "consumers-repo-wide": ["formatPrice"]
      }
    },
    {
      "id": "consumers-moved-export",
      "title": {
        "ru": "Экспорт переехал в другой файл — потребитель не сломан",
        "en": "Export moved to another file is not a broken consumer"
      },
      "base": {
        "src/money.ts": "export function formatPrice(value: number): string {\n  return value.toFixed(2);\n}\n",
        "src/page.ts": "import { formatPrice } from './money';\nexport const label = formatPrice(1);\n"
      },
      "branch": {
        "src/money.ts": "export const CURRENCY = 'EUR';\n",
        "src/format.ts": "export function formatPrice(value: number): string {\n  return value.toFixed(2);\n}\n"
      },
      "expect": {
        "consumers-repo-wide": []
      }
    },
    {
      "id": "tests-alongside-missing",
      "title": {
        "ru": "Код продукта изменён без теста",
        "en": "Product code changed with no test"
      },
      "branch": {
        "src/app.ts": "export function main(): number {\n  return 2;\n}\n"
      },
      "expect": {
        "tests-alongside": ["src/app.ts"]
      }
    },
    {
      "id": "tests-alongside-present",
      "title": {
        "ru": "Код изменён вместе с тестом",
        "en": "Product code changed together with its test"
      },
      "branch": {
        "src/app.ts": "export function main(): number {\n  return 2;\n}\n",
        "src/app.test.ts": "import { expect, it } from 'vitest';\nimport { main } from './app';\nit('main', () => expect(main()).toBe(2));\n"
      },
      "expect": {
        "tests-alongside": []
      }
    },
    {
      "id": "migration-destructive",
      "title": {
        "ru": "Разрушающий оператор в миграции",
        "en": "Destructive statement in a migration"
      },
      "branch": {
        "db/migrations/002_drop.sql": "DROP TABLE users;\n"
      },
      "expect": {
        "migration-safety": ["db/migrations/002_drop.sql"]
      }
    }
  ]
}
