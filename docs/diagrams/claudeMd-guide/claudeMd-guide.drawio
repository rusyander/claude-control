            <mxPoint x="110" y="1050" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="p2:legend:cap8" value="возврат к прежнему" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=9;fontColor=#546E7A;verticalAlign=middle;sample=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="1040" width="150" height="20" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
