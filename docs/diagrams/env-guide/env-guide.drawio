          </mxGeometry>
        </mxCell>
        <mxCell id="edge:e:bulk:e:shared" value="остальные" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;fontColor=#37474F;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;jettySize=auto;strokeWidth=2;strokeColor=#2E7D32;exitX=1;exitY=0.15;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="e:bulk" target="e:shared">
          <mxGeometry relative="1" x="0" y="-44" as="geometry">
