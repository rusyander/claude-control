            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge:g:disk:g:registry" value="и запись о нём" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;fontColor=#37474F;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;jettySize=auto;strokeWidth=2;strokeColor=#1565C0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="g:disk" target="g:registry">
          <mxGeometry relative="1" x="0" y="0" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="edge:g:registry:g:session" value="подхватится при старте" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;fontColor=#37474F;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;jettySize=auto;strokeWidth=2;strokeColor=#1565C0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="g:registry" target="g:session">
          <mxGeometry relative="1" x="0" y="0" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="edge:g:registry:g:missing" value="запись пережила каталог" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;fontColor=#37474F;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;jettySize=auto;strokeWidth=2;strokeColor=#78909C;dashed=1;dashPattern=6 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="g:registry" target="g:missing">
          <mxGeometry relative="1" x="0" y="0" as="geometry">
